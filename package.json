{
  "name": "flypig-helps-you-save",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm libs && pnpm -r typecheck",
    "test": "pnpm libs && pnpm -r test",
    "libs": "pnpm --filter @flypig/logger --filter @flypig/shared build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dev": "pnpm --filter @flypig/logger build && pnpm -r --parallel --filter @flypig/admin --filter @flypig/web dev",
    "dev:admin": "pnpm --filter @flypig/logger build && pnpm --filter @flypig/admin dev",
    "dev:web": "pnpm --filter @flypig/web dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "typescript": "^6.0.3"
  }
}
